<!DOCTYPE html>
<html lang="en" data-theme="corporate">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>InsureSmart | Cross-Device Insurance Comparison</title>
    <meta name="description" content="Compare insurance plans seamlessly across all devices. Get instant quotes for health, auto, and life insurance.">
    
    <!-- SEO & Schema -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "InsuranceAgency",
        "name": "InsureSmart",
        "image": "https://yourdomain.com/logo.png",
        "priceRange": "$$-$$$"
    }
    </script>

    <!-- Critical CSS -->
    <style>
        :root {
            --safe-area-inset-left: env(safe-area-inset-left);
            --safe-area-inset-right: env(safe-area-inset-right);
        }

        .fluid-grid {
            grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
        }

        @media (hover: hover) {
            .insurance-card:hover {
                transform: translateY(-3px);
            }
        }

        .tap-target {
            min-width: 48px;
            min-height: 48px;
        }
    </style>

    <!-- Load CSS -->
    <link href="https://cdn.jsdelivr.net/npm/daisyui@3.9.2/dist/full.css" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="bg-base-100">
    <!-- Adaptive Navigation -->
    <nav class="fixed bottom-0 md:top-0 w-full bg-base-100/95 backdrop-blur-md z-50 border-t md:border-b border-base-200 safe-area-padding">
        <div class="container mx-auto px-4">
            <div class="flex justify-between items-center py-2">
                <!-- Mobile Menu -->
                <div class="md:hidden flex-1 flex justify-around gap-1">
                    <a href="#health" class="btn btn-ghost tap-target flex-col">
                        🏥 <span class="text-xs mt-1">Health</span>
                    </a>
                    <a href="#auto" class="btn btn-ghost tap-target flex-col">
                        🚗 <span class="text-xs mt-1">Auto</span>
                    </a>
                    <a href="#life" class="btn btn-ghost tap-target flex-col">
                        ❤️ <span class="text-xs mt-1">Life</span>
                    </a>
                </div>

                <!-- Desktop Menu -->
                <div class="hidden md:flex items-center gap-4">
                    <a class="btn btn-ghost text-xl font-bold">
                        <span class="text-primary">Insure</span><span class="text-secondary">Smart</span>
                    </a>
                    <div class="flex gap-2">
                        <a href="#health" class="btn btn-primary btn-sm">Health</a>
                        <a href="#auto" class="btn btn-secondary btn-sm">Auto</a>
                        <a href="#life" class="btn btn-accent btn-sm">Life</a>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <main class="container mx-auto px-4 pt-4 md:pt-20 pb-24 md:pb-12 safe-area-padding">
        <!-- Health Insurance Section -->
        <section id="health" class="mb-16 scroll-mt-16">
            <h2 class="text-3xl md:text-4xl font-bold mb-6 md:mb-8">Health Insurance</h2>
            <div class="fluid-grid grid gap-4 md:gap-6">
                <!-- Health Providers -->
                <article class="insurance-card card bg-base-100 shadow-sm transition-transform duration-300">
                    <div class="card-body p-4 md:p-6">
                        <div class="flex flex-col md:flex-row justify-between gap-4">
                            <div class="flex-1">
                                <h3 class="text-lg md:text-xl font-semibold">BlueCross Platinum</h3>
                                <div class="badge badge-primary mt-2">Most Popular</div>
                                <p class="text-sm text-neutral/70 mt-2">PPO Plans • $0 Deductible</p>
                            </div>
                            <div class="md:text-right">
                                <p class="text-xl md:text-2xl font-bold text-primary">$329</p>
                                <button class="btn btn-primary btn-sm mt-2 w-full md:w-auto">
                                    View Plans
                                </button>
                            </div>
                        </div>
                    </div>
                </article>
                <!-- Add 4 more health cards -->
            </div>
        </section>

        <!-- Auto Insurance Section -->
        <section id="auto" class="mb-16 scroll-mt-16">
            <h2 class="text-3xl md:text-4xl font-bold mb-6 md:mb-8">Auto Insurance</h2>
            <div class="fluid-grid grid gap-4 md:gap-6">
                <!-- Auto Providers -->
                <article class="insurance-card card bg-base-100 shadow-sm transition-transform duration-300">
                    <div class="card-body p-4 md:p-6">
                        <div class="flex flex-col md:flex-row justify-between gap-4">
                            <div class="flex-1">
                                <h3 class="text-lg md:text-xl font-semibold">Geico Advantage</h3>
                                <div class="badge badge-secondary mt-2">Best Value</div>
                                <p class="text-sm text-neutral/70 mt-2">15% Safe Driver Discount</p>
                            </div>
                            <div class="md:text-right">
                                <p class="text-xl md:text-2xl font-bold text-secondary">$89</p>
                                <button class="btn btn-secondary btn-sm mt-2 w-full md:w-auto">
                                    Get Quote
                                </button>
                            </div>
                        </div>
                    </div>
                </article>
                <!-- Add 4 more auto cards -->
            </div>
        </section>

        <!-- Life Insurance Section -->
        <section id="life" class="mb-16 scroll-mt-16">
            <h2 class="text-3xl md:text-4xl font-bold mb-6 md:mb-8">Life Insurance</h2>
            <div class="fluid-grid grid gap-4 md:gap-6">
                <!-- Life Providers -->
                <article class="insurance-card card bg-base-100 shadow-sm transition-transform duration-300">
                    <div class="card-body p-4 md:p-6">
                        <div class="flex flex-col md:flex-row justify-between gap-4">
                            <div class="flex-1">
                                <h3 class="text-lg md:text-xl font-semibold">Northwestern Mutual</h3>
                                <div class="badge badge-accent mt-2">Top Rated</div>
                                <p class="text-sm text-neutral/70 mt-2">Term & Whole Life</p>
                            </div>
                            <div class="md:text-right">
                                <p class="text-xl md:text-2xl font-bold text-accent">$45</p>
                                <button class="btn btn-accent btn-sm mt-2 w-full md:w-auto">
                                    Calculate
                                </button>
                            </div>
                        </div>
                    </div>
                </article>
                <!-- Add 4 more life cards -->
            </div>
        </section>
    </main>

    <!-- Trust & Footer -->
    <div class="bg-base-200">
        <div class="container mx-auto px-4 py-8 text-center">
            <div class="flex flex-wrap justify-center gap-6 mb-4">
                <img src="trust-badge-ssl.svg" alt="SSL Secure" class="h-12 w-auto" loading="lazy">
                <img src="trust-badge-bbb.svg" alt="BBB Accredited" class="h-12 w-auto" loading="lazy">
            </div>
            <p class="text-sm text-neutral/70">*Average monthly rates shown for comparison</p>
        </div>
    </div>

    <footer class="bg-base-300 text-neutral">
        <div class="container mx-auto px-4 py-8">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-8 text-sm">
                <div>
                    <h3 class="font-bold mb-3">Insurance Types</h3>
                    <ul class="space-y-2">
                        <li><a href="#health" class="link-hover">Health</a></li>
                        <li><a href="#auto" class="link-hover">Auto</a></li>
                        <li><a href="#life" class="link-hover">Life</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="font-bold mb-3">Company</h3>
                    <ul class="space-y-2">
                        <li><a href="#" class="link-hover">About</a></li>
                        <li><a href="#" class="link-hover">Contact</a></li>
                        <li><a href="#" class="link-hover">Careers</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="font-bold mb-3">Legal</h3>
                    <ul class="space-y-2">
                        <li><a href="#" class="link-hover">Privacy</a></li>
                        <li><a href="#" class="link-hover">Terms</a></li>
                        <li><a href="#" class="link-hover">Disclosures</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="font-bold mb-3">Partners</h3>
                    <ul class="space-y-2">
                        <li><a href="#" class="link-hover">Affiliates</a></li>
                        <li><a href="#" class="link-hover">Providers</a></li>
                        <li><a href="#" class="link-hover">Developers</a></li>
                    </ul>
                </div>
            </div>
            <div class="mt-8 pt-6 border-t border-base-200 text-center">
                <p class="text-sm">&copy; 2024 InsureSmart. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script>
        // Adaptive Navigation
        const updateNavigation = () => {
            const nav = document.querySelector('nav');
            if (window.innerWidth >= 768) {
                nav.classList.remove('bottom-0', 'border-t');
                nav.classList.add('top-0', 'border-b');
            } else {
                nav.classList.add('bottom-0', 'border-t');
                nav.classList.remove('top-0', 'border-b');
            }
        };

        window.addEventListener('resize', updateNavigation);
        updateNavigation();

        // Smooth Scroll
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function(e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                const offset = window.innerWidth >= 768 ? 100 : 80;
                window.scrollTo({
                    top: target.offsetTop - offset,
                    behavior: 'smooth'
                });
            });
        });
    </script>
</body>
</html>
